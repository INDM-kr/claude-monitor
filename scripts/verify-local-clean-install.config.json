{
  "rootFiles": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "README.md", "CLAUDE.md", "bin/claude-monitor"],
  "packages": ["core", "adapter-claude-code", "collector", "web"],
  "packageFiles": ["package.json", "tsconfig.json", "vitest.config.ts"],
  "webFiles": ["next.config.mjs", "next-env.d.ts", "postcss.config.mjs", "plugins.config.ts", "tailwind.config.ts"],
  "codeDirectories": ["src", "app", "lib", "public"],
  "scriptExtensions": [".mjs", ".cjs", ".js", ".json", ".sh", ".py"],
  "sourceExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".json", ".jsonl", ".css", ".md", ".txt", ".svg", ".png", ".ico", ".woff", ".woff2"],
  "excludedNames": ["node_modules", "dist", "coverage", "private"],
  "installTimeoutMs": 600000,
  "buildTimeoutMs": 600000,
  "startupTimeoutMs": 60000,
  "shutdownTimeoutMs": 15000,
  "requestTimeoutMs": 15000,
  "logLimitBytes": 262144,
  "pollMs": 150,
  "bindHost": "127.0.0.1"
}
